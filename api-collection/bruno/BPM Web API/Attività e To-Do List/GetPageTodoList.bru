meta {
  name: GetPageTodoList
  type: http
  seq: 2
}

post {
  url: {{bpmUrl}}/api/ext/GetPageTodoList
  body: json
  auth: none
}

body:json {
  {
    "authenticationToken": "{{apiKey}}",
    "userName": "{{userName}}",
    "fromDate": "2026-01-01",
    "toDate": "2026-12-31",
    "filterByUser": "",
    "filterByText": "",
    "filterByPriority": "",
    "includeCompleted": false,
    "includePlanned": false,
    "includeCC": false,
    "Page": 1,
    "Size": 20
  }
}

docs {
  To-Do List paginata: aggiunge page, size, totalRecords, totalPages.

  Documentazione: sezione Integrazione > Web API del sito BPM.
}

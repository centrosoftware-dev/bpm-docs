meta {
  name: SearchDocuments
  type: http
  seq: 7
}

post {
  url: {{bpmUrl}}/api/ext/SearchDocuments
  body: json
  auth: none
}

body:json {
  {
    "authenticationToken": "{{apiKey}}",
    "userName": "{{userName}}",
    "Models": [
      "{{documentModel}}"
    ],
    "Filters": [
      {
        "Name": "fix_documentdate",
        "Value": null,
        "ValueIn": []
      }
    ],
    "dossierType": ""
  }
}

docs {
  Ricerca per metadati e campi generali fix_*.

  Documentazione: sezione Integrazione > Web API del sito BPM.
}

meta {
  name: DownloadDocument
  type: http
  seq: 8
}

post {
  url: {{bpmUrl}}/api/ext/DownloadDocument
  body: json
  auth: none
}

body:json {
  {
    "authenticationToken": "{{apiKey}}",
    "userName": "{{userName}}",
    "InstanceId": "{{documentInstanceId}}",
    "Version": 0
  }
}

docs {
  Scarica il file (risposta binaria). Version facoltativa.

  Documentazione: sezione Integrazione > Web API del sito BPM.
}

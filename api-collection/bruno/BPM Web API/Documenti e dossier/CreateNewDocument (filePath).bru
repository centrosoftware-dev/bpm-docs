meta {
  name: CreateNewDocument (filePath)
  type: http
  seq: 2
}

post {
  url: {{bpmUrl}}/api/ext/CreateNewDocument
  body: json
  auth: none
}

body:json {
  {
    "authenticationToken": "{{apiKey}}",
    "userName": "{{userName}}",
    "model": "{{documentModel}}",
    "startObject": "{{startObject}}",
    "variables": {
      "Metadato": "valore"
    },
    "sourceType": "filePath",
    "filePathSource": {
      "extension": ".pdf",
      "filePath": "\\\\server\\cartella\\documento.pdf",
      "deleteAfter": false
    }
  }
}

script:post-response {
  if (res.body && res.body.instanceId) bru.setEnvVar("documentInstanceId", res.body.instanceId);
  if (res.body && res.body.documentName) bru.setEnvVar("documentNameDoc", res.body.documentName);
}

docs {
  Crea un documento leggendo il file da un percorso raggiungibile dal server BPM.

  Documentazione: sezione Integrazione > Web API del sito BPM.
}

meta {
  name: AddDocumentToDossier
  type: http
  seq: 12
}

post {
  url: {{bpmUrl}}/api/ext/AddDocumentToDossier
  body: json
  auth: none
}

body:json {
  {
    "authenticationToken": "{{apiKey}}",
    "userName": "{{userName}}",
    "InstanceId": "{{documentInstanceId}}",
    "Dossier": {
      "Type": "TIPO DOSSIER",
      "ID": 0,
      "Name": "Dossier di prova",
      "Description": "",
      "Contact": "",
      "Company": ""
    }
  }
}

docs {
  Inserisce il documento in un dossier (creato se non esiste).

  Documentazione: sezione Integrazione > Web API del sito BPM.
}

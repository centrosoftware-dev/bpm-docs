meta {
  name: GetProcess (per nome)
  type: http
  seq: 3
}

post {
  url: {{bpmUrl}}/api/ext/GetProcess
  body: json
  auth: none
}

body:json {
  {
    "authenticationToken": "{{apiKey}}",
    "userName": "{{userName}}",
    "model": "{{processModel}}",
    "documentName": "{{documentName}}",
    "includeVariables": [
      "*"
    ],
    "includeGraph": false
  }
}

docs {
  Come GetProcess, identificando l'istanza con modello + nome.

  Documentazione: sezione Integrazione > API standard del sito BPM.
}

meta {
  name: GetSchema
  type: http
  seq: 7
}

post {
  url: {{bpmUrl}}/api/ext/GetSchema
  body: json
  auth: none
}

body:json {
  {
    "authenticationToken": "{{apiKey}}",
    "modelName": "{{processModel}}",
    "activityName": "{{startObject}}"
  }
}

docs {
  Variabili richieste da uno start o da un'attività.

  Documentazione: sezione Integrazione > API standard del sito BPM.
}

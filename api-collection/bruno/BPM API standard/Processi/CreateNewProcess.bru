meta {
  name: CreateNewProcess
  type: http
  seq: 1
}

post {
  url: {{bpmUrl}}/api/ext/CreateNewProcess
  body: json
  auth: none
}

body:json {
  {
    "authenticationToken": "{{apiKey}}",
    "userName": "{{userName}}",
    "model": "{{processModel}}",
    "startObject": "{{startObject}}",
    "variables": {
      "Nome variabile": "valore",
      "Importo": 100.5,
      "Data": "2026-01-31",
      "Gruppo righe": [
        {
          "Codice": "P01",
          "Descrizione": "Riga 1"
        }
      ]
    },
    "attachments": [
      {
        "fileName": "esempio.txt",
        "content": "RXNlbXBpbyBkaSBhbGxlZ2F0bw==",
        "root": "",
        "folder": "",
        "group": "",
        "isEmail": false
      }
    ]
  }
}

script:post-response {
  if (res.body && res.body.instanceId) bru.setEnvVar("instanceId", res.body.instanceId);
  if (res.body && res.body.documentName) bru.setEnvVar("documentName", res.body.documentName);
}

docs {
  Avvia una nuova istanza di un modello di processo.

  Documentazione: sezione Integrazione > API standard del sito BPM.
}

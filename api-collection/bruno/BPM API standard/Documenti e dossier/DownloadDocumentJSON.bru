meta {
  name: DownloadDocumentJSON
  type: http
  seq: 9
}

post {
  url: {{bpmUrl}}/api/ext/DownloadDocumentJSON
  body: json
  auth: none
}

body:json {
  {
    "authenticationToken": "{{apiKey}}",
    "userName": "{{userName}}",
    "InstanceId": "{{documentInstanceId}}",
    "Version": 0
  }
}

docs {
  Scarica il file dentro un JSON (FileData in base64).

  Documentazione: sezione Integrazione > API standard del sito BPM.
}

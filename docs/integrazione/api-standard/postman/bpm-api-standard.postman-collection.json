{
  "info": {
    "name": "BPM API standard",
    "description": "Chiamate delle API standard di BPM (/api/ext). Imposta l'ambiente 'BPM' con bpmUrl, apiKey e userName.\n\nDocumentazione: sezione Integrazione > API standard del sito BPM.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Processi",
      "item": [
        {
          "name": "CreateNewProcess",
          "request": {
            "description": "Avvia una nuova istanza di un modello di processo.\n\nDocumentazione: sezione Integrazione > API standard del sito BPM.",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{bpmUrl}}/api/ext/CreateNewProcess",
              "host": [
                "{{bpmUrl}}"
              ],
              "path": [
                "api",
                "ext",
                "CreateNewProcess"
              ]
            },
            "method": "POST",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"authenticationToken\": \"{{apiKey}}\",\n  \"userName\": \"{{userName}}\",\n  \"model\": \"{{processModel}}\",\n  \"startObject\": \"{{startObject}}\",\n  \"variables\": {\n    \"Nome variabile\": \"valore\",\n    \"Importo\": 100.5,\n    \"Data\": \"2026-01-31\",\n    \"Gruppo righe\": [\n      {\n        \"Codice\": \"P01\",\n        \"Descrizione\": \"Riga 1\"\n      }\n    ]\n  },\n  \"attachments\": [\n    {\n      \"fileName\": \"esempio.txt\",\n      \"content\": \"RXNlbXBpbyBkaSBhbGxlZ2F0bw==\",\n      \"root\": \"\",\n      \"folder\": \"\",\n      \"group\": \"\",\n      \"isEmail\": false\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.instanceId) pm.environment.set(\"instanceId\", r.instanceId);",
                  "if (r.documentName) pm.environment.set(\"documentName\", r.documentName);"
                ]
              }
            }
          ]
        },
